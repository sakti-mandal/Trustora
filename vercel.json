{
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__route__=/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py?__route__=/auth/$1"
    },
    {
      "source": "/compliance/(.*)",
      "destination": "/api/index.py?__route__=/compliance/$1"
    },
    {
      "source": "/content/(.*)",
      "destination": "/api/index.py?__route__=/content/$1"
    },
    {
      "source": "/companies/(.*)",
      "destination": "/api/index.py?__route__=/companies/$1"
    },
    {
      "source": "/guidelines/(.*)",
      "destination": "/api/index.py?__route__=/guidelines/$1"
    },
    {
      "source": "/brand-rules/(.*)",
      "destination": "/api/index.py?__route__=/brand-rules/$1"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/api/index.py?__route__=/dashboard/$1"
    },
    {
      "source": "/notifications/(.*)",
      "destination": "/api/index.py?__route__=/notifications/$1"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__route__=/health"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py?__route__=/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?__route__=/openapi.json"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/((?!assets|favicon|logo|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
