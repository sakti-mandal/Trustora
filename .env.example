# ==============================================================================
# TRUSTORA ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (PostgreSQL for Production, SQLite fallback for Local Dev)
# PostgreSQL example: postgresql://user:password@host:5432/trustora
DATABASE_URL=sqlite:///./backend/trustora.db

# Google Gemini API Key for Semantic RAG Analysis
# If not provided, TRUSTORA gracefully runs in intelligent "Rule-Based Demo Mode"
GEMINI_API_KEY=your_gemini_api_key_here

# Application Environment (development / production)
APP_ENV=development

# Secret Key for JWT & Session security
SECRET_KEY=trustora-enterprise-secret-key-2026

# Frontend API URL (leave empty or default for same-origin proxy)
# VITE_API_URL=http://127.0.0.1:8000
